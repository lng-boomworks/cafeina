---
import '../styles/global.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  locale?: 'en' | 'es';
}

const {
  title,
  description = 'Relaxing vintage café in La Marina, Alicante - coffee, afternoon tea, cakes & craft cocktails, family-run since 2009.',
  ogImage = '/images/og-default.jpg',
  type = 'website',
  noindex = false,
  locale = 'en',
} = Astro.props;

const ogLocale = locale === 'es' ? 'es_ES' : 'en_GB';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase(ogImage), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Reveal the intro overlay before first paint, but only when JS is on,
         motion is allowed, and it's the first visit this session. No-JS / repeat
         visits / reduced-motion never see it, so the page is identical. -->
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var seen = sessionStorage.getItem("cafeina_intro");
          if (!reduce && !seen) document.documentElement.classList.add("intro");
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Cafeina" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase("/favicon-192.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />

    <!-- Fonts (preload critical, async the rest) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- JSON-LD: LocalBusiness (every page) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CafeOrCoffeeShop",
      "@id": "https://cafeinalamarina.com/#business",
      "name": "Cafeina",
      "alternateName": "Cafeina La Marina",
      "description": "Relaxing vintage café in La Marina, Alicante - coffee, afternoon tea, cakes and craft cocktails, family-run since 2009.",
      "url": "https://cafeinalamarina.com/",
      "image": "https://cafeinalamarina.com/images/hero/street-entrance.jpeg",
      "logo": "https://cafeinalamarina.com/images/brand/cafeina-logo-brown.png",
      "telephone": "+34711051358",
      "email": "hola@cafeinalamarina.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle Luis de Gongora Sector VI-VII Local 43-44",
        "addressLocality": "San Fulgencio",
        "addressRegion": "Alicante",
        "postalCode": "03177",
        "addressCountry": "ES"
      },
      "servesCuisine": ["Coffee", "Afternoon Tea", "Cakes", "Cocktails", "Wine", "Spirits"],
      "openingHours": ["Mo-Sa 09:00-01:00", "Su 17:00-01:00"],
      "priceRange": "€€",
      "sameAs": [
        "https://www.facebook.com/cafeinavintage",
        "https://www.instagram.com/cafeinalamarina/"
      ],
      "foundingDate": "2009"
    })} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <div id="intro-overlay" aria-hidden="true">
      <div class="text-center px-6">
        <picture class="intro-mark inline-block">
          <source srcset={withBase("/images/brand/cafeina-logo-white.webp")} type="image/webp" />
          <img
            src={withBase("/images/brand/cafeina-logo-white.png")}
            alt=""
            width={579}
            height={195}
            class="h-12 md:h-14 w-auto"
          />
        </picture>
        <div class="intro-rule"></div>
      </div>
    </div>

    <slot />

    <!-- Site-wide motion: Lenis smooth scroll + GSAP ScrollTrigger scrub.
         Bundled module script; runs once on every page. -->
    <script>
      import Lenis from "lenis";
      import gsap from "gsap";
      import ScrollTrigger from "gsap/ScrollTrigger";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Intro overlay: fade out (first visit) or remove immediately otherwise.
      const overlay = document.getElementById("intro-overlay");
      if (overlay && document.documentElement.classList.contains("intro")) {
        try { sessionStorage.setItem("cafeina_intro", "1"); } catch (e) {}
        setTimeout(() => {
          overlay.classList.add("intro-hide");
          setTimeout(() => overlay.remove(), 800);
        }, 950);
      } else if (overlay) {
        overlay.remove();
      }

      if (!reduce) {
        gsap.registerPlugin(ScrollTrigger);
        // Enables tall-pin sizing in CSS (see global.css `.pin-on`).
        document.documentElement.classList.add("pin-on");

        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        // Scrub effects on opted-in sections. Uses a sticky inner element for the
        // "pinned" feel (no DOM mutation), so it's safe alongside React islands.
        const initScrub = () => {
          document.querySelectorAll("[data-pin-scrub]").forEach((el) => {
            const img = el.querySelector("[data-pin-image]");
            const text = el.querySelector("[data-pin-text]");
            if (img) {
              gsap.fromTo(
                img,
                { scale: 1 },
                {
                  scale: 1.07,
                  ease: "none",
                  scrollTrigger: { trigger: el, start: "top top", end: "bottom bottom", scrub: true },
                }
              );
            }
            if (text) {
              gsap.fromTo(
                text,
                { y: 28, autoAlpha: 0.55 },
                {
                  y: 0,
                  autoAlpha: 1,
                  ease: "none",
                  scrollTrigger: { trigger: el, start: "top 70%", end: "top 32%", scrub: true },
                }
              );
            }
          });
          ScrollTrigger.refresh();
        };

        // Let islands hydrate + layout settle before measuring.
        window.addEventListener("load", () => requestAnimationFrame(initScrub));
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => ScrollTrigger.refresh());
        let resizeRaf = 0;
        window.addEventListener("resize", () => {
          cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(() => ScrollTrigger.refresh());
        });
      }
    </script>
  </body>
</html>
