---
import Base from '../layouts/Base.astro';
import { EventsPage } from '../components/pages/EventsPage';
import { getEventsPage, getUpcomingEvents, getPastEvents, getEventPhotos } from '../utils/events';

// Single source of truth: src/data/cafeina_events.json (validated by the events
// collection at build sync). Events auto-split into upcoming vs past by date_iso.
const d = getEventsPage();
const upcoming = getUpcomingEvents('en');
const past = getPastEvents('en');
const photos = getEventPhotos();
---

<Base title={d.seo_title ?? 'Events at Cafeina La Marina'} description={d.seo_description}>
  <EventsPage
    client:load
    heroLabel={d.hero_label}
    heroHeading={d.hero_heading}
    heroSubheading={d.hero_subheading}
    heroImage={d.hero_image}
    heroImageAlt={d.hero_image_alt}
    introHeading={d.intro_heading}
    introBody={d.intro_body}
    upcoming={upcoming}
    past={past}
    photos={photos}
    ctaHeading={d.cta_heading}
    ctaText={d.cta_text}
  />
</Base>
