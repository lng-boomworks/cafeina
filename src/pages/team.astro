---
import Base from '../layouts/Base.astro';
import { TeamPage } from '../components/pages/TeamPage';
import { getTeamPage, getTeamMembers } from '../utils/team';

// Single source of truth: src/data/cafeina_team.json (validated by the
// teamMembers collection at build sync). Page copy + members both come from it.
const d = getTeamPage();
const members = getTeamMembers('en');
---

<Base title={d.seo_title ?? 'Meet the team - Cafeina La Marina'} description={d.seo_description}>
  <TeamPage
    client:load
    heroLabel={d.hero_label}
    heroHeading={d.hero_heading}
    heroSubheading={d.hero_subheading}
    heroLandscapeImage={d.hero_landscape_image}
    heroLandscapeImageAlt={d.hero_landscape_image_alt}
    introHeading={d.intro_heading}
    introBody={d.intro_body}
    members={members}
    ctaHeading={d.cta_heading}
    ctaText={d.cta_text}
  />
</Base>
